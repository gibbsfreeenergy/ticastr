# Used only by compose.yaml. Copy to .env and replace every placeholder.
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
REDIS_PASSWORD=change-me
APP_REDIS_ENABLED=false
MONITORING_TOKEN=change-me
PAGINATION_CURSOR_SECRET=replace-with-a-long-random-secret
XRAY_TRAFFIC_ENABLED=false
XRAY_TRAFFIC_BASE_URL=
XRAY_TRAFFIC_SHARED_SECRET=
XRAY_TRAFFIC_MAX_SKEW_SECONDS=90
API_PUBLIC_URL=http://localhost:8090
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters
BOOTSTRAP_ADMIN_NICKNAME=Administrator
VITE_TENCENT_CAPTCHA_ID=replace-me

# Managed storage profiles in the database select runtime storage. The values below are
# migration-only inputs read once while the bootstrap state is incomplete.
STORAGE_CONFIG_ENCRYPTION_KEY=
# Optional one-time active-provider hint; leave blank to use the V21 database hint.
STORAGE_ACTIVE_PROVIDER=
STORAGE_LOCAL_ROOT=/data/uploads/
STORAGE_LOCAL_PUBLIC_URL=/uploads/
OSS_ENDPOINT=
OSS_BUCKET=
OSS_REGION=
OSS_PUBLIC_URL=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
COS_ENDPOINT=
COS_BUCKET=
COS_REGION=
COS_PUBLIC_URL=
COS_SECRET_ID=
COS_SECRET_KEY=
TOS_ENDPOINT=
TOS_BUCKET=
TOS_REGION=
TOS_PUBLIC_URL=
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
