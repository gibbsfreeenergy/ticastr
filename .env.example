# Used only by compose.yaml. Copy to .env and replace every placeholder.
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
REDIS_PASSWORD=change-me
APP_REDIS_ENABLED=false
MONITORING_TOKEN=change-me
API_PUBLIC_URL=http://localhost:8090
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters
BOOTSTRAP_ADMIN_NICKNAME=Administrator
VITE_QQ_APP_ID=replace-me
VITE_QQ_REDIRECT_URI=http://localhost:8080/oauth/login/qq
VITE_WEIBO_APP_ID=replace-me
VITE_WEIBO_REDIRECT_URI=http://localhost:8080/oauth/login/weibo
VITE_TENCENT_CAPTCHA_ID=replace-me
VITE_MUSIC_API_BASE_URL=https://music-api.example.com

# Active object storage: local, oss, cos or tos. Configure only the selected cloud provider.
STORAGE_ACTIVE_PROVIDER=local
STORAGE_LOCAL_ROOT=/data/uploads/
STORAGE_LOCAL_PUBLIC_URL=/uploads/
OSS_ENDPOINT=
OSS_BUCKET=
OSS_REGION=
OSS_PUBLIC_URL=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
COS_ENDPOINT=
COS_BUCKET=
COS_REGION=
COS_PUBLIC_URL=
COS_SECRET_ID=
COS_SECRET_KEY=
TOS_ENDPOINT=
TOS_BUCKET=
TOS_REGION=
TOS_PUBLIC_URL=
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
