{
  "name": "ticastr-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "build": "vite build",
    "build:seo": "npm run build && npm run optimize:images && npm run generate:feeds && node scripts/prerender.mjs && npm run verify:static && npm run verify:budget",
    "preview": "vite preview",
    "generate:feeds": "node scripts/generate-site-feeds.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "verify:budget": "node scripts/check-bundle-budget.mjs",
    "verify:static": "node scripts/check-static-contract.mjs",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:seo": "node --test scripts/generate-site-feeds.test.mjs scripts/prerender.test.mjs"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "animate.css": "^4.1.1",
    "axios": "^1.13.2",
    "clipboard": "^2.0.11",
    "dayjs": "^1.11.19",
    "dompurify": "^3.4.12",
    "easy-typer-js": "^2.1.0",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "nprogress": "^0.2.0",
    "recorderx": "^2.0.2",
    "tocbot": "4.18.2",
    "v3-infinite-loading": "^1.3.2",
    "vue": "^3.5.39",
    "vue-avatar-cropper": "^6.1.1",
    "vue-router": "^5.1.0",
    "vuetify": "^4.1.4",
    "vuex": "^4.1.0",
    "vuex-persistedstate": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "sass-embedded": "^1.93.3",
    "sharp": "^0.35.4",
    "stylus": "^0.64.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
