<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wzh.blog.dao.StorageBootstrapStateDao">
    <sql id="bootstrapStateColumns">
        id, legacy_import_completed, legacy_active_provider, completed_at
    </sql>

    <select id="selectForUpdate" resultType="com.wzh.blog.entity.StorageBootstrapState">
        SELECT <include refid="bootstrapStateColumns"/>
        FROM tb_storage_bootstrap_state
        WHERE id = 1
        FOR UPDATE
    </select>

    <update id="markCompleted">
        UPDATE tb_storage_bootstrap_state
        SET legacy_import_completed = 1,
            completed_at = #{completedAt}
        WHERE id = 1
    </update>
</mapper>
