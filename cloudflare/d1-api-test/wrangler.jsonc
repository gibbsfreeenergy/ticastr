{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "ticastr-d1-api-test",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT": "test",
    "LEGACY_OSS_PUBLIC_ORIGIN": "https://ticastr-photo.oss-cn-hangzhou.aliyuncs.com",
    "PUBLIC_ASSET_ORIGIN": "https://pages-proxy-test.ticastr.cn/api",
    "SESSION_TTL_SECONDS": "21600",
    "XRAY_TRAFFIC_BASE_URL": "https://ticastr-dmit.duckdns.org:8443/internal/traffic",
    "XRAY_TRAFFIC_MAX_SKEW_SECONDS": "90"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ticastr",
      "database_id": "37dfa6e4-7033-48dc-bb4e-330d84118c19"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "ticastr"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "4b3ff32a51ea40569d2d6ea3a2ee0f00"
    }
  ]
}
