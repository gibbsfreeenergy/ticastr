{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "ticastr-pages-proxy-test",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "vars": {
    "PROXY_LABEL": "test"
  },
  "routes": [
    {
      "pattern": "pages-proxy-test.ticastr.cn",
      "custom_domain": true
    }
  ]
}
