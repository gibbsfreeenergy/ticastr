{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "ticastr-admin-proxy-test",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "vars": {
    "PROXY_LABEL": "admin-d1-test",
    "PAGES_ORIGIN": "https://ticastr-admin.pages.dev",
    "API_ORIGIN": "https://ticastr-d1-api-test.gibbsfree8660.workers.dev"
  },
  "services": [
    {
      "binding": "D1_API",
      "service": "ticastr-d1-api-test"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    {
      "pattern": "admin-d1-test.ticastr.cn",
      "custom_domain": true
    }
  ]
}
